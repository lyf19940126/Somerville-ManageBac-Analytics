# ManageBac CN API base URL (optional, default shown)
MANAGEBAC_BASE_URL=https://api.managebac.cn

# ManageBac API token (required). Sent via header: auth-token
MANAGEBAC_TOKEN=

# Homeroom advisor numeric ID used to scope students (required)
HOMEROOM_ADVISOR_ID=12726007

# Target cohort graduating year (required)
TARGET_GRADUATING_YEAR=2028

# ManageBac term ID for class assessments term grades (required)
TERM_ID=106673

# Report timezone (optional). On Windows, install tzdata if ZoneInfo lookup fails.
REPORT_TIMEZONE=Asia/Shanghai
